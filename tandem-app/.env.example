# GOOGLE_APPLICATION_CREDENTIALS — path to your GCP service account JSON key.
# Download from: GCP Console → IAM → Service Accounts → Keys → Add Key → JSON
# Required for: Google Cloud Speech-to-Text (hearing user captions)
#              Google Cloud Text-to-Speech (ASL prediction audio)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# ── TURN Server (WebRTC NAT traversal) ────────────────────────────────────────
# Required for video calls across different networks / firewalls.
# If you are on the same LAN you can omit these; the app falls back to STUN.
TURN_URLS=turn:<your-turn-server-ip>:3478
TURN_USERNAME=turnuser
TURN_CREDENTIAL=changeme

# ── Security ──────────────────────────────────────────────────────────────────
# In production set this to your domain to lock down CORS.
# In development leave it unset (defaults to * so localhost/ngrok work).
# ALLOWED_ORIGIN=https://tandem.example.com

# ── Model (production / Docker) ───────────────────────────────────────────────
# URL to download asl/model.p if it is not present at container startup.
# Can be a GCS signed URL, S3 pre-signed URL, or any direct download link.
# MODEL_URL=https://storage.googleapis.com/your-bucket/model.p

# ── Optional ──────────────────────────────────────────────────────────────────
# Port for the Node.js server (default: 3000)
# PORT=3000

# Language code for speech recognition (default: en-US)
# LANGUAGE_CODE=en-US


# ANTHROPIC_API_KEY=sk-ant-...