# Core calls and typed replies need no .env file, cloud keys, or ASL model.
PORT=3000

# Use Node 24 for development and deployment.
# Private invitations are enabled by default and expire after 8 hours.
# A random signing secret is generated for local development if omitted;
# those invitations expire immediately on server restart.
# Set a persistent random secret to keep invitations valid across restarts.
# Generate one with: openssl rand -hex 32
# ROOM_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-bytes
# ROOM_TTL_SECONDS=28800

# Public deployment requires NODE_ENV=production, a persistent signing secret,
# and exact HTTPS browser origins. Wildcards are rejected.
# NODE_ENV=production
# ALLOWED_ORIGIN=https://tandem.example.com
# Behind a reverse proxy, specify the exact trusted hop count (0 by default).
# The app port must not be directly reachable when trusting forwarded IPs.
# TRUST_PROXY_HOPS=1

# Coturn use-auth-secret credentials: share this random secret with coturn.
# Only temporary usernames/passwords are sent to invited browsers.
# TURN_URLS=turn:your-turn-server:3478,turns:your-turn-server:5349?transport=tcp
# TURN_SHARED_SECRET=replace-with-a-random-secret-at-least-32-bytes
# TURN_TTL_SECONDS=3600

# Legacy room-code-only admission and static TURN credentials are development
# compatibility options. They are rejected in production.
# REQUIRE_ROOM_TOKEN=false
# TURN_USERNAME=development-only-user
# TURN_CREDENTIAL=development-only-password

# Google Cloud speech is optional. Supply application credentials to enable it,
# or set ENABLE_SPEECH=true when using Application Default Credentials/workload identity.
# ENABLE_SPEECH=false explicitly disables both captions and speech output.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# ENABLE_SPEECH=true
# Set false to keep captions enabled without paid text-to-speech output.
# ENABLE_SPEECH_OUTPUT=false
# LANGUAGE_CODE=en-US

# Experimental recognition is off by default and requires a Python model service.
# Start it separately with npm run asl. Recognized words are private drafts;
# the signer reviews them and chooses Send. Claude suggestions are optional.
# ENABLE_ASL=true
# ASL_API_URL=http://127.0.0.1:5003/predict
# ANTHROPIC_API_KEY=your-api-key

# Experimental signing avatar is off by default; it uses the external sign.mt service.
# ENABLE_AVATAR=true

# Maximum simultaneously active caption streams in this server instance.
# Additional callers see an unavailable state and can retry when capacity frees.
# MAX_CAPTION_STREAMS=20

# Optional protected Prometheus metrics. Generate independently of room/TURN secrets.
# Disabled unless configured; use Authorization: Bearer <token> when scraping.
# METRICS_TOKEN=replace-with-a-random-secret-at-least-32-bytes
