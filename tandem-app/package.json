{
  "name": "tandem-app",
  "version": "1.0.0",
  "description": "Unified video conferencing app connecting deaf and hearing users with ASL recognition",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "NODE_ENV=development node --env-file=.env server.js",
    "asl": "python server/asl_api.py",
    "start:all": "concurrently --kill-others-on-fail --names \"node,asl\" --prefix-colors \"cyan,green\" \"npm start\" \"npm run asl\"",
    "test": "node --test test/smoke.test.js",
    "asl:download": "python asl/download_dataset.py",
    "asl:collect": "python asl/collect.py",
    "asl:train": "python asl/train.py",
    "docker:build": "docker build -t tandem-app .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env -v \"$(pwd)/asl/model.p:/app/asl/model.p\" tandem-app"
  },
  "author": "Hiruy Worku",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@google-cloud/speech": "^7.2.1",
    "@google-cloud/text-to-speech": "^6.4.0",
    "concurrently": "^8.2.0",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  }
}
