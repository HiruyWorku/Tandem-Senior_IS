{
  "name": "tandem-app",
  "version": "1.0.0",
  "description": "Unified video conferencing app connecting deaf and hearing users with ASL recognition",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "NODE_ENV=development node --env-file-if-exists=.env server.js",
    "asl": "python server/asl_api.py",
    "start:all": "concurrently --kill-others-on-fail --names \"node,asl\" --prefix-colors \"cyan,green\" \"npm start\" \"npm run asl\"",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "test:browser:compat": "playwright test --config playwright.compat.config.js",
    "asl:download": "python asl/download_dataset.py",
    "asl:collect": "python asl/collect.py",
    "asl:train": "python asl/train.py",
    "docker:build": "docker build -t tandem-app .",
    "docker:run": "docker run --rm -e NODE_ENV=development -p 3000:3000 tandem-app"
  },
  "author": "Hiruy Worku",
  "engines": {
    "node": ">=22.16 <25"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@google-cloud/speech": "^7.2.1",
    "@google-cloud/text-to-speech": "^6.4.0",
    "concurrently": "^8.2.0",
    "express": "^4.21.2",
    "proxy-addr": "^2.0.8",
    "socket.io": "^4.8.1"
  },
  "overrides": {
    "express": {
      "qs": "^6.16.0"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "socket.io-client": "^4.8.4"
  }
}
