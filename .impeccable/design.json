      "css": ".ds-device-label{display:block;font-family:\"DM Sans\",system-ui,sans-serif; color:var(--text);font-size:1rem;font-weight:500;margin-bottom:8px}.ds-device-select{font-family:\"DM Sans\",system-ui,sans-serif; color:var(--text);width:100%;min-width:0;min-height:44px;padding:8px;border:1px solid var(--border-3);border-radius:var(--r-sm);background:var(--bg);font-size:1rem;color-scheme:dark}.ds-device-select:focus-visible{outline:2px solid var(--amber);outline-offset:3px;}.ds-device-select:disabled{opacity:.55}"
