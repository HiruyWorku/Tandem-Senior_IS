      "refersTo": "footer-control",
      "description": "Icon-over-label footer control opening inline device settings.",
      "html": "<button class=\"ds-device-toggle\" type=\"button\" aria-expanded=\"false\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 4v6m0 4v6m8-16v10m0 4v2m8-16v2m0 4v10\"/><path d=\"M1 10h6m2 8h6m2-12h6\"/></svg>Devices</button>",
      "css": ".ds-device-toggle{display:flex;flex-direction:column;align-items:center;gap:3px;padding:9px 16px;min-width:64px;border-radius:var(--r-md);border:1px solid var(--border-2);background:var(--surface);font-family:\"DM Sans\",sans-serif;color:var(--text);font-size:10.5px;font-weight:500;letter-spacing:.02em;cursor:pointer;transition:all var(--t-xs) var(--ease)}.ds-device-toggle svg{width:17px;height:17px}.ds-device-toggle:hover{background:var(--surface-2);border-color:var(--border-3);transform:translateY(-1px)}.ds-device-toggle:active{transform:scale(.96)}.ds-device-toggle:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "Device action",
      "kind": "button",
      "refersTo": "device-action",
      "description": "Use selected devices and Close share this neutral action treatment.",
      "html": "<button class=\"ds-device-action\" type=\"button\">Use selected devices</button>",
      "css": ".ds-device-action{font-family:\"DM Sans\",system-ui,sans-serif; color:var(--text);font-size:14px;padding:6px 10px;min-height:44px;border:1px solid var(--border-3);border-radius:var(--r-sm);background:var(--surface);cursor:pointer}.ds-device-action:hover{background:var(--surface-2)}.ds-device-action:focus-visible{outline:2px solid var(--amber);outline-offset:3px;}.ds-device-action:disabled{opacity:.55;cursor:wait}"
